PORT=8787
JWT_SECRET=please-change-this-secret

# Supabase Postgres connection string.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_SSL=true

# Text chat provider, usually DeepSeek or an OpenAI-compatible relay.
CHAT_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=
CHAT_MODEL=deepseek-v4-pro

# Optional: image understanding model for uploaded reference images.
# If your chat provider does not support image input, use a vision-capable model/provider here later.
VISION_MODEL=

# Poster image generation provider.
IMAGE_BASE_URL=https://api.weelinking.com/v1
IMAGE_GENERATIONS_URL=https://api.weelinking.com/v1/images/generations
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024

# Cloudflare R2 storage.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=qin-poster
R2_PUBLIC_URL=https://your-public-r2-domain.example.com
